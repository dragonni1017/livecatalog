# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/
/.build-final/

# build/scratch output (never commit — may inline secrets)
/tmp/
*.fuse_hidden*

# production
/build

# misc
.DS_Store
*.pem

# local Claude Code workspace + scratch scripts + one-off data exports
/.claude/
scripts/_tmp_*.mjs
scripts/_*.mjs
/_tmp_*
/data/livecatalog-category-breakdown.xlsx
/data/*.bak

# root-level scratch exports (inventory counts, image backfill mappings,
# QB comparisons, etc.) — these belong in data/ or docs/, never commit
# straight from repo root. Added 2026-07-14 after a cleanup found ~30 loose
# files + 3.7GB of image dumps sitting untracked in root; actually relocated
# 2026-07-15 into the data/ subfolders below. Root rules kept as a guard
# against the same clutter recurring.
/*.xlsx
/*.csv
/*.pdf
/imgur-upload/
/recent-3mo-images/
/*.ps1

# scratch working files relocated from repo root 2026-07-15 — same
# never-commit intent as the root-level rules above, just organized by topic
/data/images/
/data/inventory-counts/
/data/price-comparisons/
/data/livecatalog-products.xlsx
/data/erply-review/
/data/erply-woo-review/
/data/erply-woo-customer-backfill/
/data/erply-duplicate-cleanup/
/data/price-rebase-review/
/data/product-review/
/data/price-quarter-round-review/
/data/woo-tier-review/
/data/woo-category-review/
/export-out/

# superseded scratch exports moved aside (not deleted) during the 2026-07-14
# cleanup — same never-commit intent, newer versions live in the folders above
/data/archive/

# Excel lock files
~$*.xls*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
